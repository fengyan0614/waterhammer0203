# 2. 核心处理引擎（原有逻辑完全保留）
# ==========================================
def get_signal_data(file_path):
    df = pd.read_csv(file_path, header=None)
    t_full, p_full = df.iloc[:, 0].values, df.iloc[:, 1].values
    fs = 1.0 / np.median(np.diff(t_full))
    p_smooth = pd.Series(p_full).rolling(window=int(fs), min_periods=1).mean().values
    high_idx = np.where(p_smooth > 95.0)[0]
    shut_idx = high_idx[-1] + np.where(p_smooth[high_idx[-1]:] < 80.0)[0][0] if len(high_idx) > 0 else np.argmin(
        np.gradient(p_full))
    start, end = max(0, shut_idx - int(2 * fs)), min(len(t_full), shut_idx + int(80 * fs))
    p_filt = filtfilt(*butter(4, [2.5 / (0.5 * fs), 30.0 / (0.5 * fs)], btype='band'), p_full[start:end])

    # 核心计算：分贝化 (dB)
    cep = ifft(20 * np.log10(np.abs(fft(p_filt)) + 1e-10)).real
    return t_full, p_full, t_full[start:end], (t_full[start:end] - t_full[start]), p_filt, np.arange(
        len(cep)) / fs, cep, fs


def solve_stage_grid(que, cep, targets, truth_list):
    best_acc, best_params, best_results = -1, {}, []
    neg_cep = -cep
    roi = ((1380 * que) / 2 > min(targets) - 80) & ((1380 * que) / 2 < max(targets) + 80)
    mad = np.median(np.abs(neg_cep[roi] - np.median(neg_cep[roi])))
    for v in V_SPACE:
        for t_m in T_SPACE:
            thr = max(0.0002, mad * t_m)
            peaks, _ = find_peaks(neg_cep[roi], height=thr, width=1.0)
            p_d, p_a, p_q = (v * que[roi][peaks]) / 2, cep[roi][peaks], que[roi][peaks]
            bids = sorted([{'s': (-p_a[j]) * np.exp(-(abs(p_d[j] - targets[i]) ** 2) / (2 * 8 ** 2)), 'c': i, 'p': j}
                           for i in range(len(targets)) for j in range(len(p_d)) if
                           abs(p_d[j] - targets[i]) <= MAX_ERR],
                          key=lambda x: x['s'], reverse=True)
            res_wh, details, a_c, a_p = [0] * len(targets), [None] * len(targets), set(), set()
            for b in bids:
                if b['c'] not in a_c and b['p'] not in a_p:
                    a_c.add(b['c']);
                    a_p.add(b['p']);
                    res_wh[b['c']] = 1
                    details[b['c']] = {'d': round(p_d[b['p']], 1), 'e': round(p_d[b['p']] - targets[b['c']], 1),
                                       'q': p_q[b['p']], 'a': p_a[b['p']]}
            acc = sum(1 for k in range(len(res_wh)) if res_wh[k] == truth_list[k]) / len(targets)
            if acc > best_acc or (acc == best_acc and abs(v - 1380) < abs(best_params.get('v', 1380) - 1380)):
                best_acc, best_params, best_results = acc, {'v': v, 't': thr}, [
                    {'wh': "开启" if res_wh[m] == 1 else "未识别", 'info': details[m]} for m in range(len(targets))]
    return best_acc, best_params, best_results


