# ==========================================
# 新增：反射系数计算核心函数
# ==========================================
def calculate_reflection_coefficient(p_filt, t_r, fs, detected_depths, best_v):
    """
    计算各射孔簇的反射系数R
    :param p_filt: 滤波后的压力信号 (MPa)
    :param t_r: 相对时间序列 (s)
    :param fs: 采样频率 (Hz)
    :param detected_depths: 识别到的射孔簇深度列表 (m)
    :param best_v: 最优波速 (m/s)
    :return: 各射孔簇的反射系数结果列表
    """
    # 1. 单位转换：压力从MPa转换为Pa，再转换为水头H (m) = P/(ρg)
    g = 9.81  # 重力加速度 (m/s²)
    p_pa = p_filt * 1e6  # MPa → Pa
    H = p_pa / (FLUID_DENSITY * g)  # 水头 (m)

    # 2. 计算流量Q：基于水锤波传播的连续性方程
    dH_dt = np.gradient(H, t_r)  # 水头时间导数
    Q = (WELLBORE_AREA * g / best_v) * dH_dt  # 井筒流量 (m³/s)

    # 3. 计算各射孔簇对应的反射系数
    reflection_results = []
    for depth in detected_depths:
        if depth is None:
            reflection_results.append(None)
            continue

        # 计算该深度对应的时间窗口（波速*时间/2=深度 → 时间=2*深度/波速）
        target_time = 2 * depth / best_v
        # 找到该时间附近的信号窗口（±0.1s）
        time_window = (t_r >= target_time - 0.1) & (t_r <= target_time + 0.1)

        if not np.any(time_window):
            reflection_results.append(None)
            continue

        # 计算特征阻抗Zc2 = ΔP/ΔQ (Pa·s/m³ = kg/(m²·s))
        delta_P = np.std(p_pa[time_window])  # 压力波动幅值 (Pa)
        delta_Q = np.std(Q[time_window])  # 流量波动幅值 (m³/s)

        if delta_Q < 1e-8:  # 避免除零
            reflection_results.append(None)
            continue

        Zc2 = delta_P / delta_Q
        # 反射系数核心公式：R = (Zc2 - Zc1) / (Zc2 + Zc1)
        R = (Zc2 - Zc1_BASE) / (Zc2 + Zc1_BASE)
        reflection_results.append(round(R, 3))  # 保留3位小数

    return reflection_results


