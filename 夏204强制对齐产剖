# 核心分析参数：放宽绝对误差限制，确保能抓到极微弱的波
V_SPACE = np.arange(1300, 1460, 1.0)
MAX_ERR = 25.0  # 放宽到25米，确保极限情况下也能抓到候选峰
WINDOW_SIZE, STEP_SIZE = 10.0, 1.0

