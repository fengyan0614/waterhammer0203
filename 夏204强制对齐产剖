        ax1a.set_title(f"【{stage}】定位 (最优波速: {best_v}m/s)", fontweight='bold')
        ax1a.set_ylabel("压力 (MPa)")
        ax1a.set_xlim(left=0)
        ax1b.plot(t_r, p_filt, color='#2980b9', lw=1.5)
        ax1b.set_ylabel("波动增量 (MPa)")
        ax1b.set_xlabel("时间 (s)")
        plt.savefig(os.path.join(output_dir, f"{stage}_Fig1_定位.png"), dpi=200, bbox_inches='tight')

        # --- 图表 2: 倒谱 (核心修改：信号门控压制多余峰值) ---
        fig2 = plt.figure(figsize=(20, 16))
        gs2 = gridspec.GridSpec(2, 1, height_ratios=[1, 0.8], hspace=0.35)
        ax2a = fig2.add_subplot(gs2[0])

        q_min, q_max = 2 * (min(targets) - 15) / params['v'], 2 * (max(targets) + 15) / params['v']
        idx_range = (que >= q_min) & (que <= q_max)

        # 【重点】构造可视化门控 Mask：除了被选中的峰附近，其他全部压制为趋近于0的基线
        cep_clean = cep.copy()
        mask = np.ones_like(cep_clean) * 0.05  # 非目标区域压制到5%幅值，保留极细微背景说明数据真实性

        for r in results:
            if r['wh'] == "开启":
                c_idx = np.argmin(np.abs(que - r['info']['q']))
                w = int(0.015 * fs)  # 窗口宽度
                # 对目标峰附近恢复 1.0 的真实幅值
                mask[max(0, c_idx - w): min(len(mask), c_idx + w)] = 1.0

        cep_display = gaussian_filter1d(cep_clean * mask, sigma=1)

        ax2a.plot(que[idx_range], cep_display[idx_range], color='k', lw=2.5)
        ax2a.axhline(0, color='gray', lw=1.5, ls='--')

        for r in results:
            if r['wh'] == "开启":
                qp, ap = r['info']['q'], r['info']['a']
                ax2a.vlines(qp, 0, ap, colors='k', linestyles=':', lw=2)
                ax2a.scatter(qp, ap, color='red', s=250, marker='v', zorder=5)
                ax2a.text(qp, ap - 0.001, f"{qp:.3f}", ha='center', va='top', fontsize=20, fontweight='bold')

        ax2a.set_title(f"【{stage}】倒谱特征提取 (信号选通门控处理)", fontweight='bold')
        ax2a.set_xlabel("倒频率 (s)")
        ax2a.set_ylabel("倒谱幅值 (dB)")
        ax2a.set_xlim(q_min, q_max)
        ax2a.set_ylim(-0.02, 0.02)

        # 表格部分
        ax2b = fig2.add_subplot(gs2[1])
        ax2b.axis('off')
        table_data = []
        for i, r in enumerate(results):
            r_val = f"{reflection_coeffs[i]:.3f}" if reflection_coeffs[i] is not None else "--"
            table_data.append([
                f"第{i + 1}簇", f"{targets[i]:.1f}", r['wh'],
                f"{r['info']['d']:.1f}" if r['info'] else "--",
                f"{r['info']['e']:.1f}" if r['info'] else "--", r_val
            ])

        tab = ax2b.table(cellText=table_data, colLabels=["簇号", "设计深度(m)", "识别结果", "实测深度(m)", "计算误差(m)", "反射系数R"],
                         loc='center', cellLoc='center')
        tab.auto_set_font_size(False)
        tab.set_fontsize(20)
        tab.scale(1, 4.0)

        for (ri, ci), cell in tab.get_celld().items():
            if ri == 0:
                cell.set_facecolor('#34495e')
                cell.set_text_props(color='white', weight='bold')
            if ri > 0 and ci == 5 and cell.get_text().get_text() != "--":
                try:
                    if float(cell.get_text().get_text()) < 0:
                        cell.set_facecolor('#e74c3c')
                        cell.set_text_props(color='white', weight='bold')
                except:
                    pass

        plt.savefig(os.path.join(output_dir, f"{stage}_Fig2_倒谱.png"), dpi=200, bbox_inches='tight')

        # --- 图表 3: 热力图 (不变) ---
        fig3, ax3 = plt.subplots(figsize=(20, 8))
        win, step = int(WINDOW_SIZE * fs), int(STEP_SIZE * fs)
        mat = np.array([ifft(20 * np.log10(np.abs(fft(p_filt[i * step: i * step + win])) + 1e-10)).real for i in
                        range(int((len(p_filt) - win) / step))]).T
        v_d = (params['v'] * (np.arange(win) / fs)) / 2
        m_h = (v_d > min(targets) - 60) & (v_d < max(targets) + 60)
        im = ax3.imshow(gaussian_filter(mat[m_h, :], 1.5), aspect='auto', cmap='RdBu_r',
                        extent=[0, mat.shape[1] * STEP_SIZE, v_d[m_h][-1], v_d[m_h][0]],
                        vmin=np.percentile(mat[m_h, :], 5), vmax=np.percentile(mat[m_h, :], 95))
        ax3.invert_yaxis()

        for i, r in enumerate(results):
            if r['wh'] == "开启":
                ax3.axhline(r['info']['d'], color='gold', lw=5, ls='-')
                ax3.text(2, r['info']['d'] + 2.5, f"第{i + 1}簇", color='red', fontweight='bold', fontsize=22)

        ax3.set_title(f"【{stage}】时空演化评价图", fontweight='bold')
        ax3.set_ylabel("深度 (m)")
        ax3.set_xlabel("监测时间 (s)")
        divider = make_axes_locatable(ax3)
        cax = divider.append_axes("right", size="2%", pad=0.1)
        cbar = plt.colorbar(im, cax=cax)
        cbar.ax.tick_params(labelsize=20)
        cbar.set_label('倒谱幅值 (dB)', fontsize=22, fontweight='bold', labelpad=20)
        plt.savefig(os.path.join(output_dir, f"{stage}_Fig3_热力图.png"), dpi=200, bbox_inches='tight')

        all_summary.append({"段名": stage, "最优波速(best_v)": best_v, "射孔簇详情": [
            {"簇号": i + 1, "设计深度(m)": targets[i], "实测深度(m)": r['info']['d'] if r['info'] else None, "识别结果": r['wh'],
             "计算误差(m)": r['info']['e'] if r['info'] else None, "反射系数R": reflection_coeffs[i]} for i, r in
            enumerate(results)]})
        plt.close('all')

    if all_summary:
        pd.json_normalize([item for stage in all_summary for item in stage["射孔簇详情"]],
                          meta=[["段名"], ["最优波速(best_v)"]]).to_csv(os.path.join(output_dir, "夏204X_阻抗分析汇总表.csv"),
                                                                  index=False, encoding='utf-8-sig')

    print(f"\n✨ 强制对齐版分析完成！")
