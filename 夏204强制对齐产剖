# ===================== 反射系数计算参数 =====================
FLUID_DENSITY = 1000.0
WELLBORE_DIAMETER = 0.1143
WELLBORE_AREA = np.pi * (WELLBORE_DIAMETER / 2) ** 2
Zc1_BASE = FLUID_DENSITY * 1380 / WELLBORE_AREA

stage_configs = {
    "第1段": [6051.0, 6037.0, 6024.5],
    "第2段": [6004.5, 5984.5, 5970.5, 5958.5],
    "第3段": [5938.0, 5928.0, 5914.0],
    "第4段": [5891.0, 5873.0, 5857.0],
    "第5段": [5836.0, 5825.5, 5815.0, 5806.0],
}


def calculate_reflection_coefficient(p_filt, t_r, fs, detected_depths, best_v):
    g = 9.81
    p_pa = p_filt * 1e6
    H = p_pa / (FLUID_DENSITY * g)

    dH_dt = np.gradient(H, t_r)
    Q = (WELLBORE_AREA * g / best_v) * dH_dt

    reflection_results = []
    for depth in detected_depths:
        if depth is None:
            reflection_results.append(None)
            continue
        target_time = 2 * depth / best_v
        time_window = (t_r >= target_time - 0.1) & (t_r <= target_time + 0.1)

        if not np.any(time_window):
            reflection_results.append(None)
            continue
        delta_P = np.std(p_pa[time_window])
        delta_Q = np.std(Q[time_window])

        if delta_Q < 1e-8:
            reflection_results.append(None)
            continue
        Zc2 = delta_P / delta_Q
        R = (Zc2 - Zc1_BASE) / (Zc2 + Zc1_BASE)
        reflection_results.append(round(R, 3))
    return reflection_results


def get_signal_data(file_path):
    df = pd.read_csv(file_path, header=None)
    t_full, p_full = df.iloc[:, 0].values, df.iloc[:, 1].values
    fs = 1.0 / np.median(np.diff(t_full))
    p_smooth = pd.Series(p_full).rolling(window=int(fs), min_periods=1).mean().values
    high_idx = np.where(p_smooth > 95.0)[0]
    shut_idx = high_idx[-1] + np.where(p_smooth[high_idx[-1]:] < 80.0)[0][0] if len(high_idx) > 0 else np.argmin(
        np.gradient(p_full))
    start, end = max(0, shut_idx - int(2 * fs)), min(len(t_full), shut_idx + int(150 * fs))
    p_filt = filtfilt(*butter(4, [2.5 / (0.5 * fs), 30.0 / (0.5 * fs)], btype='band'), p_full[start:end])
    cep = ifft(20 * np.log10(np.abs(fft(p_filt)) + 1e-10)).real
    return t_full, p_full, t_full[start:end], (t_full[start:end] - t_full[start]), p_filt, np.arange(
        len(cep)) / fs, cep, fs


def solve_stage_grid_forced(que, cep, targets, expected_count):
    """
    强制对齐产剖算法：移除传统阈值限制，对所有局部极值进行高斯打分，
    强制选取排名前 expected_count 的结果。
    """
    best_params, best_results = {}, []
    neg_cep = -cep
    roi = ((1380 * que) / 2 > min(targets) - 80) & ((1380 * que) / 2 < max(targets) + 80)

    best_v = 1380
    best_details = [None] * len(targets)
    best_res_wh = [0] * len(targets)
    best_error = float('inf')

    for v in V_SPACE:
        # 门槛降到极低（1e-6），把所有微小的扰动都当作候选峰
        peaks, _ = find_peaks(neg_cep[roi], height=1e-6)
        p_d, p_a, p_q = (v * que[roi][peaks]) / 2, cep[roi][peaks], que[roi][peaks]

        # 计算所有可能匹配的得分（结合幅值和距离惩罚）
        bids = []
        for i in range(len(targets)):
            for j in range(len(p_d)):
                err = abs(p_d[j] - targets[i])
                if err <= MAX_ERR:
                    # 减弱距离惩罚力度 (方差设为15)
                    score = (-p_a[j]) * np.exp(-(err ** 2) / (2 * 15 ** 2))
                    bids.append({'s': score, 'c': i, 'p': j, 'err': err, 'd': p_d[j], 'a': p_a[j], 'q': p_q[j]})

        # 按得分从高到低严格排序
        bids = sorted(bids, key=lambda x: x['s'], reverse=True)

        res_wh = [0] * len(targets)
        details = [None] * len(targets)
        a_c, a_p = set(), set()
        current_count = 0

        # 贪婪选择：强制挑出最好的 expected_count 个
        for b in bids:
            if current_count >= expected_count:
                break
            if b['c'] not in a_c and b['p'] not in a_p:
                a_c.add(b['c'])
                a_p.add(b['p'])
                res_wh[b['c']] = 1
                details[b['c']] = {'d': round(b['d'], 1), 'e': round(b['err'], 1), 'q': b['q'], 'a': b['a']}
                current_count += 1

        # 如果成功找齐了指定数量，评价其整体深度误差
        if current_count == expected_count:
            current_error = sum([abs(details[i]['e']) for i in range(len(targets)) if res_wh[i] == 1]) / expected_count
            if current_error < best_error:
                best_error = current_error
                best_v = v
                best_res_wh = res_wh
                best_details = details

    best_params = {'v': best_v}
    best_results = [{'wh': "开启" if best_res_wh[m] == 1 else "未识别",
                     'info': best_details[m]} for m in range(len(targets))]

    return best_params, best_results


if __name__ == "__main__":
    all_files = glob.glob(os.path.join(data_dir, "*.csv"))
    all_summary = []

    # 你的核心先验：强制约束的目标数量
    target_open_counts = {
        "第1段": 1,
        "第2段": 1,
        "第3段": 1,
        "第4段": 2,
        "第5段": 3,
    }

    for stage, targets in stage_configs.items():
        f_path = next((f for f in all_files if stage in f), None)
        if not f_path:
            continue

        t_f, p_f, t_a, t_r, p_filt, que, cep, fs = get_signal_data(f_path)
        expected_count = target_open_counts.get(stage, 1)

        # 运行强制对齐算法
        params, results = solve_stage_grid_forced(que, cep, targets, expected_count)
        best_v = params['v']

        detected_depths = [r['info']['d'] if r['info'] else None for r in results]
        reflection_coeffs = calculate_reflection_coefficient(p_filt, t_r, fs, detected_depths, best_v)

